# Proxmox API base URL (no trailing slash)
PROXMOX_URL=https://proxmox.example.com:8006

# Token id form: user@realm!tokenid
PROXMOX_TOKEN_ID=mcp@pve!readonly

# Token secret (shown once at creation). Never commit this file.
PROXMOX_TOKEN_SECRET=

# Verify TLS certificates (set false only for lab self-signed certs)
PROXMOX_VERIFY_TLS=true

# Optional request timeout in seconds
PROXMOX_TIMEOUT=30
